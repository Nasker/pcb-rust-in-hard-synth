(footprint "DIN-5-MIDI-RA" (layer "F.Cu")
	(descr "Right-angle PCB-mount DIN-5 socket (MIDI), Jalco YKF51-5050")
	(tags "DIN-5 MIDI connector right-angle YKF51")
	(property "Reference" "REF**" (at 0 -3.5) (layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "DIN-5-MIDI-RA" (at 0 21) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole)
	(fp_circle (center 0 9.45) (end 8 9.45) (layer "F.Fab") (width 0.15))
	(fp_circle (center 0 9.45) (end 9.5 9.45) (layer "F.SilkS") (width 0.15))
	(fp_rect (start -10.5 -0.5) (end 10.5 19.5) (layer "F.CrtYd") (width 0.05) (fill none))
	(pad "4" thru_hole oval (at -5 2.5) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(pad "5" thru_hole oval (at 5 2.5) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole oval (at 0 12.4) (size 1.7 2.5) (drill oval 1 1.5) (layers "*.Cu" "*.Mask"))
	(pad "1" thru_hole oval (at -5 15.1) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(pad "3" thru_hole oval (at 5 15.1) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(pad "SH" thru_hole oval (at -7.5 12.4) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(pad "SH" thru_hole oval (at 7.5 12.4) (size 2.5 1.7) (drill oval 1.5 1) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/Local_Libraries/DIN-5-Jack.step"
		(offset (xyz 0 -2 10))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
